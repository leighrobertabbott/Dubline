DUB_ENGINE=indextts
DUB_WORKDIR=./data
INDEXTTS_REPO=./vendor/index-tts
INDEXTTS_MODEL_DIR=./vendor/index-tts/checkpoints
WHISPER_MODEL=turbo
WHISPER_CACHE_DIR=./vendor/whisper
BANDIT_REPO=./vendor/bandit-v2
BANDIT_CHECKPOINT=./vendor/bandit-v2/checkpoints/checkpoint-multi.ckpt
ADAPTER_MODEL=./vendor/qwen3-8b/Qwen3-8B-Q4_K_M.gguf
TRANSLATION_MODEL=./vendor/hy-mt2-7b/Hy-MT2-7B-Q4_K_M.gguf
QWEN_ASR_MODEL=./vendor/qwen3-asr-0.6b-qwen
QWEN_ASR_ESCALATION_MODEL=./vendor/qwen3-asr-1.7b-qwen
QWEN_ALIGNER_MODEL=./vendor/qwen3-forced-aligner-0.6b-qwen
OPENCV_FACE_MODEL_DIR=./vendor/opencv-face
QWEN_TTS_MODEL=./vendor/qwen3-tts-1.7b-base
ROFORMER_MODEL_DIR=./vendor/melband-roformer/melband-roformer-kim-vocals
PYANNOTE_MODEL=./vendor/pyannote-community-1
MUSETALK_REPO=./vendor/MuseTalk
MUSETALK_MODEL_DIR=./vendor/MuseTalk/models/musetalkV15
# Isolated runtime paths are detected automatically on Windows and Linux.
# Optional and conservative: only clean, single-face shots which fail visible timing QC.
MUSETALK_ENABLED=0
MUSETALK_MAX_SHOTS=6
DUB_DIARIZATION_DEVICE=cuda
# 'auto' reads the model's real block count from its GGUF header and places as
# many layers on the GPU as measurably fit, so a model larger than 8 GB still
# runs at the best split the card allows instead of an arbitrary fixed number.
# Set an integer to override, or 0 to keep the model entirely in system RAM.
DUB_LLAMA_GPU_LAYERS=auto
DUB_LLAMA_VRAM_HEADROOM_MB=400
# Translation is the one heavy stage that is not latency-bound: a whole feature
# is roughly 50k output tokens. A larger GGUF that spills into system RAM will
# still finish overnight and is the single biggest quality lever available on
# this hardware. Point these at any GGUF; the split is sized automatically.
TRANSLATION_MODEL=./vendor/hy-mt2-7b/Hy-MT2-7B-Q4_K_M.gguf
TRANSLATION_QC_MODEL=./vendor/qwen3-8b/Qwen3-8B-Q4_K_M.gguf
# How many acoustically distinct takes to keep per character. Each line then
# clones from whichever take most resembles how that line was actually
# delivered, instead of from one clip for the entire film.
DUB_REFERENCE_VARIANTS=4
# Every non-English line is read a second time by Whisper before translation
# begins, because the primary transcript comes from a 0.6B model whose
# escalation gate measures alignment fit rather than whether the words were
# right. Where the two models disagree, both readings travel forward as
# evidence instead of one being assumed correct. Lower this to cap the cost;
# the budget is spent on the least trustworthy lines first.
DUB_SOURCE_VERIFY_MAX_LINES=1500
DUB_GPU_ABORT_TEMPERATURE_C=90
DUB_GPU_WATCHDOG_SECONDS=0.5
# A laptop 4060 sits in the high 70s under sustained inference. Holding out for
# 72C meant waiting at nearly every line boundary; 80/77 is a temperature the
# card can actually reach between lines. The 90C hard abort above is unchanged.
DUB_GPU_SOFT_TEMPERATURE_C=80
DUB_GPU_COOLDOWN_TARGET_C=77
# Brief settle between lines so consecutive bursts do not stack; the real hold
# is now measured against the sensor rather than slept unconditionally.
DUB_GPU_LINE_SETTLE_SECONDS=0.15
DUB_GPU_LINE_COOLDOWN_LIMIT_SECONDS=45
# IndexTTS's own value is 25. Lower trades voice quality in the mel stage for
# speed; 16 was a concession to a thermally starved pipeline. Drop it back if
# you would rather have the wall-clock than the last of the quality.
INDEXTTS_DIFFUSION_STEPS=25
DUB_GPU_AUTO_RESUME_LIMIT=12
DUB_GPU_AUTO_RESUME_TIMEOUT_SECONDS=600
HF_TOKEN=
# Media processing remains local. When enabled, catalogue matching sends only a
# parsed title/year/episode identifier and caches the resulting artwork locally.
MEDIA_LOOKUP_ENABLED=1
# Dubline ships its own TMDB application token in app/config.py, so users never
# need an account. Set one of these only to override it with your own token --
# yours always wins over the bundled one.
DUBLINE_TMDB_TOKEN=
DUBLINE_TMDB_API_KEY=

# Speaking rate band. Studies of professional dubbing find human dubbers hold
# their rate steady and let timing slip, not the reverse -- dubbed speech has
# lower rate variance than the source performance. IndexTTS accepts 0.5-2.0,
# but the pipeline previously swung across that whole range to fill fixed
# windows, which is what produced half-speed vowels and gabbled lines. A line
# that will not fit at a natural rate is a translation problem: the timing-QC
# pass rewrites the words instead.
DUB_RATE_FLOOR=0.86
DUB_RATE_CEILING=1.16
