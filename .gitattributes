# Normalise to LF inside the repository so line endings never show up as diffs.
* text=auto

# Windows launchers must keep CRLF on disk: batch parsing of labels and goto
# is unreliable with LF endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must keep LF on disk or Linux fails with "bad interpreter: ^M".
*.sh text eol=lf

# Web and Python sources stay LF everywhere.
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.mkv binary
*.mp4 binary
*.wav binary
*.flac binary
*.gguf binary
*.safetensors binary
*.pt binary
*.pth binary
